@using MVC_Library.Models.Entities
@model List<Book>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-4">
    <h1 class="mb-4">Kütüphanemizde @Model.Count kitap var.</h1>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Kitap Adı</th>
                <th>Yazar</th>
                <th>Sayfa Sayısı</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PageCount sayfa</td>
                </tr>
            }
        </tbody>
    </table>
</div>